[
  {
    "action": "open_app",
    "app": "notepad.exe",
    "arguments": [
      "cache\\aletheia-acceptance.txt"
    ]
  },
  {
    "action": "wait_window",
    "window": {
      "title_re": ".*aletheia-acceptance.*"
    },
    "timeout_s": 15
  },
  {
    "action": "focus_window",
    "window": {
      "title_re": ".*aletheia-acceptance.*"
    }
  },
  {
    "action": "set_text",
    "window": {
      "title_re": ".*aletheia-acceptance.*"
    },
    "control": {
      "control_type": "Document"
    },
    "text": "Aletheia Phase 7 local acceptance passed this harmless Notepad step."
  }
]
