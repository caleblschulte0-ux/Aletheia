{
  "revision": 1,
  "fleet": "aletheia",
  "owner": "caleblschulte0-ux",
  "repos": {
    "aletheia": {
      "github": "Aletheia",
      "role": "hub",
      "status": "active",
      "summary": "The fleet's single pane of truth: registry, pulse collector, interface, ChatGPT suggestion inbox.",
      "default_branch": "main",
      "agents": [
        {"name": "interactive Claude session", "kind": "claude", "writes": "code, docs, contracts, rulings"},
        {"name": "pulse workflow", "kind": "ci", "writes": "state/pulse/*"},
        {"name": "ChatGPT advisor", "kind": "chatgpt", "writes": "exchange/suggestions/*.json only"}
      ],
      "watch": {
        "workflows": ["pulse.yml", "ci.yml"],
        "state_files": ["state/pulse/latest.json"]
      }
    },
    "shorts_pipeline": {
      "github": "Shorts-pipeline",
      "role": "youtube-automation",
      "status": "active",
      "summary": "Multi-channel automated YouTube pipeline (trending, explainer, curiosity, third) with Claude brains, a fail-closed showrunner gate, and a daily ChatGPT media/authoring exchange.",
      "default_branch": "main",
      "agents": [
        {"name": "Routine", "kind": "claude", "writes": "the day's packages via PR"},
        {"name": "showrunner", "kind": "claude", "writes": "sovereign publish verdicts"},
        {"name": "ChatGPT exchange workers", "kind": "chatgpt", "writes": "day content + media pointers"},
        {"name": "doctor reviewer", "kind": "chatgpt", "writes": "doctor/reports/<date>.json"}
      ],
      "watch": {
        "workflows": ["daily.yml", "exchange_phase_a.yml", "exchange_phase_b.yml", "story_forge.yml", "third.yml", "explainer.yml", "retro.yml", "doctor.yml"],
        "state_files": [
          "state/posted_log.json",
          "state/explainer_posted_log.json",
          "state/third_posted_log.json",
          "state/curiosity_posted_log.json",
          "state/showrunner_verdicts.jsonl",
          "config/channel_registry.json"
        ]
      }
    },
    "schwab_trader": {
      "github": "schwab-trader",
      "role": "trading-bot",
      "status": "active",
      "summary": "Guardrailed paper-trading day-trading bot for Charles Schwab: separate Claude BUY and SELL brains, executor on GitHub Actions, significance-gated sell approvals.",
      "default_branch": "main",
      "agents": [
        {"name": "BUY brain", "kind": "claude", "writes": "signals/orders.json"},
        {"name": "SELL brain", "kind": "claude", "writes": "signals/proposed_sells.json"},
        {"name": "executor", "kind": "ci", "writes": "holdings, ledgers, reports"}
      ],
      "watch": {
        "workflows": ["brain.yml", "sell-brain.yml", "trader.yml", "watchdog.yml"],
        "state_files": [
          "signals/holdings.json",
          "signals/paper_account.json",
          "signals/performance.json",
          "reports/track_record.md"
        ]
      }
    },
