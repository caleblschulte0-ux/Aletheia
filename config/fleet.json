      }
    },
    "fosstester": {
      "github": "fosstester",
      "role": "unbuilt",
      "status": "stub",
      "summary": "Empty stub — nothing but a README. No behaviour to observe yet.",
      "default_branch": "main",
      "agents": [],
      "watch": {
        "workflows": [],
        "state_files": []
      }
    }
  }
}
