{
  "revision": 4,
  "fleet": "aletheia",
  "owner": "caleblschulte0-ux",
  "repos": {
    "aletheia": {
      "github": "Aletheia",
      "role": "hub",
      "status": "active",
      "summary": "The fleet's single pane of truth: registry, pulse collector, interface, ChatGPT suggestion inbox.",
      "default_branch": "main",
      "agents": [
        {
          "name": "interactive Claude session",
          "kind": "claude",
          "writes": "code, docs, contracts, rulings"
        },
        {
          "name": "pulse workflow",
          "kind": "ci",
          "writes": "state/pulse/*"
        },
        {
          "name": "ChatGPT advisor",
          "kind": "chatgpt",
          "writes": "exchange/suggestions/*.json only"
        }
      ],
      "watch": {
        "workflows": [
          "pulse.yml",
          "ci.yml"
        ],
        "state_files": [
          "state/pulse/latest.json"
        ]
      },
      "front_door": {
        "dispatch": [
          "pulse.yml",
          "ci.yml",
          "brief.yml"
        ],
        "issues": true
      }
    },
    "shorts_pipeline": {
      "github": "Shorts-pipeline",
      "role": "youtube-automation",
      "status": "active",
      "summary": "Multi-channel automated YouTube pipeline (trending, explainer, curiosity, third) with Claude brains, a fail-closed showrunner gate, and a daily ChatGPT media/authoring exchange.",
      "default_branch": "main",
      "agents": [
        {
          "name": "Routine",
          "kind": "claude",
          "writes": "the day's packages via PR"
        },
        {
          "name": "showrunner",
          "kind": "claude",
          "writes": "sovereign publish verdicts"
        },
        {
          "name": "ChatGPT exchange workers",
          "kind": "chatgpt",
          "writes": "day content + media pointers"
        },
        {
          "name": "doctor reviewer",
          "kind": "chatgpt",
          "writes": "doctor/reports/<date>.json"
        }
      ],
      "watch": {
        "workflows": [
          "daily.yml",
          "exchange_phase_a.yml",
          "exchange_phase_b.yml",
          "story_forge.yml",
          "third.yml",
          "explainer.yml",
          "retro.yml",
          "doctor.yml"
        ],
        "state_files": [
          "state/posted_log.json",
          "state/explainer_posted_log.json",
          "state/third_posted_log.json",
          "state/curiosity_posted_log.json",
          "state/showrunner_verdicts.jsonl",
          "config/channel_registry.json"
        ]
      },
      "vitals": [
        {
          "label": "trending posted",
          "file": "state/posted_log.json",
          "probe": "count",
          "path": "posted"
        },
        {
          "label": "explainer posted",
          "file": "state/explainer_posted_log.json",
          "probe": "count",
          "path": "posted"
        },
        {
          "label": "third posted",
          "file": "state/third_posted_log.json",
          "probe": "count",
          "path": "posted"
        },
        {
          "label": "curiosity posted",
          "file": "state/curiosity_posted_log.json",
          "probe": "count",
          "path": "posted"
        }
      ],
      "front_door": {
        "dispatch": [],
        "issues": true
      }
    },
    "schwab_trader": {
      "github": "schwab-trader",
      "role": "trading-bot",
      "status": "active",
      "summary": "Guardrailed paper-trading system. The SELL brain and executor watchdog are active; the subscription-backed BUY brain and trade executor are intentionally paused until the operator resumes them.",
      "default_branch": "main",
      "agents": [
        {
          "name": "BUY brain",
          "kind": "claude",
          "writes": "signals/orders.json"
        },
        {
          "name": "SELL brain",
          "kind": "claude",
          "writes": "signals/proposed_sells.json"
        },
        {
          "name": "executor",
          "kind": "ci",
          "writes": "holdings, ledgers, reports"
        }
      ],
      "watch": {
        "workflows": [
          "sell-brain.yml",
          "watchdog.yml"
        ],
        "state_files": [
          "signals/holdings.json",
          "signals/paper_account.json",
          "signals/performance.json",
          "reports/track_record.md"
        ]
      },
      "vitals": [
        {
          "label": "realized P&L",
          "file": "signals/performance.json",
          "probe": "field",
          "path": "total_realized",
          "unit": "usd",
          "private": true
        },
        {
          "label": "win rate",
          "file": "signals/performance.json",
          "probe": "field",
          "path": "win_rate",
          "unit": "%",
          "private": true
        },
        {
          "label": "closed trades",
          "file": "signals/performance.json",
          "probe": "field",
          "path": "n",
          "private": true
        },
        {
          "label": "open positions",
          "file": "signals/paper_account.json",
          "probe": "count",
          "path": "positions",
          "private": true
        },
        {
          "label": "cash",
          "file": "signals/paper_account.json",
          "probe": "field",
          "path": "cash",
          "unit": "usd",
          "private": true
        }
      ],
      "front_door": {
        "dispatch": [],
        "issues": true
      }
    },
    "money_machine": {
      "github": "Money_Machine",
      "role": "unbuilt",
      "status": "stub",
      "summary": "Empty stub — nothing but a README. No behaviour to observe yet.",
      "default_branch": "main",
      "agents": [],
